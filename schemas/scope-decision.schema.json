{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRA Scope Decision",
  "type": "object",
  "required": [
    "decision",
    "confidence",
    "legal_confirmation_recommended",
    "questions"
  ],
  "properties": {
    "decision": {
      "enum": [
        "in_scope",
        "in_scope_article_14_only",
        "out_of_scope",
        "undetermined"
      ]
    },
    "economic_operator_role": {
      "type": "string"
    },
    "product_boundary": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string"
        },
        "remote_data_processing_solutions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "third_party_components_outside_boundary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "separately_supplied_components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "date_regime": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "legal_confirmation_recommended": {
      "type": "boolean"
    },
    "reasons_for_legal_confirmation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "answer",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          }
        }
      }
    },
    "adjudication_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decided_at_utc": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
